{% extends 'layout.html.twig' %}

{% block title %}Edit Car #{{ car_id }}{% endblock %}

{% block content %}
<h1>Edit Car #{{ car_id }}</h1>

{% if errors %}
  <div class="alert alert-error">
    <ul style="margin:0;padding-left:18px">
      {% for err in errors %}<li>{{ err }}</li>{% endfor %}
    </ul>
  </div>
{% endif %}

<div class="form-card">
  <form method="post" action="edit.php?id={{ car_id }}" novalidate>
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

    <div class="form-group">
      <label for="make">Make</label>
      <input type="text" id="make" name="make" value="{{ values.make }}" maxlength="100"
             class="{{ 'make' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'make' in field_errors %}<div class="invalid-feedback">Make is required.</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="model">Model</label>
      <input type="text" id="model" name="model" value="{{ values.model }}" maxlength="100"
             class="{{ 'model' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'model' in field_errors %}<div class="invalid-feedback">Model is required.</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="year">Year</label>
      <input type="number" id="year" name="year" value="{{ values.year }}" min="1900" max="2100"
             class="{{ 'year' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'year' in field_errors %}<div class="invalid-feedback">Enter a valid year (1900–2100).</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="color">Color</label>
      <input type="text" id="color" name="color" value="{{ values.color }}" maxlength="50"
             class="{{ 'color' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'color' in field_errors %}<div class="invalid-feedback">Color is required.</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="price">Price (€)</label>
      <input type="number" id="price" name="price" value="{{ values.price }}" min="0" step="0.01"
             class="{{ 'price' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'price' in field_errors %}<div class="invalid-feedback">Enter a valid price (0 or greater).</div>{% endif %}
    </div>

    <button type="submit" class="btn btn-blue">Update Car</button>
    &nbsp;<a href="index.php" class="btn btn-grey">Cancel</a>
  </form>
</div>
{% endblock %}
