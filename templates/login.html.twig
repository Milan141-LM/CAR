{% extends 'layout.html.twig' %}

{% block title %}Login{% endblock %}

{% block content %}
<h1>Login</h1>

{% if errors %}
  <div class="alert alert-error">
    <ul style="margin:0;padding-left:18px">
      {% for err in errors %}<li>{{ err }}</li>{% endfor %}
    </ul>
  </div>
{% endif %}

<div class="form-card">
  <form method="post" action="login.php" novalidate>
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

    <div class="form-group">
      <label for="username">Username or Email</label>
      <input type="text" id="username" name="username" value="{{ values.username }}"
             maxlength="255" autocomplete="username"
             class="{{ 'username' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'username' in field_errors %}<div class="invalid-feedback">Please enter your username or email.</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password"
             class="{{ 'password' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'password' in field_errors %}<div class="invalid-feedback">Please enter your password.</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="captcha_answer">Verify: {{ captcha.question }} = ?</label>
      <input type="text" id="captcha_answer" name="captcha_answer" inputmode="numeric"
             class="{{ 'captcha_answer' in field_errors ? 'is-invalid' : '' }}" required>
      {% if 'captcha_answer' in field_errors %}<div class="invalid-feedback">{{ field_error_messages.captcha_answer }}</div>{% endif %}
    </div>

    <button type="submit" class="btn btn-blue" style="width:100%">Login</button>
  </form>

  <p class="text-center mt-16" style="font-size:13px">
    Don't have an account? <a href="register.php">Register here</a>
  </p>
</div>
{% endblock %}
